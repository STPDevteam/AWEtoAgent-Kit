# Agent metadata
AGENT_NAME=my-identity-agent
AGENT_DESCRIPTION=Verifiable agent with on-chain identity
AGENT_VERSION=0.1.0
AGENT_DOMAIN=agent.example.com
AGENT_SHORT_DESCRIPTION=On-chain agent with verifiable identity

# Backend + token creation
AGENT_BACKEND_BASE_URL=http://localhost:3000/api
AGENT_SERVICE_TYPE=AI_AGENT
AGENT_TOKEN_NAME=Agent Token
AGENT_TOKEN_SYMBOL=AGENTA
AGENT_ACCESS_DETAILS=
AGENT_RESOURCE_LINK=https://agent.example.com
AGENT_GITHUB_LINK=
AGENT_TWITTER_LINK=
AGENT_DOCUMENT_LINK=

# Payments (x402)
PAYMENTS_FACILITATOR_URL=https://facilitator.daydreams.systems
PAYMENTS_NETWORK=base-sepolia
PAYMENTS_RECEIVABLE_ADDRESS=0xYourPaymentAddress
PAYMENTS_DEFAULT_PRICE=1000

# Blockchain configuration
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
IDENTITY_AUTO_REGISTER=true

# Identity metadata URIs
AGENT_METADATA_URI=https://agent.example.com/.well-known/agent-metadata.json
AGENT_CARD_URI=https://agent.example.com/.well-known/agent-card.json

# Wallets
AGENT_WALLET_PRIVATE_KEY=
DEVELOPER_WALLET_PRIVATE_KEY=

# Agent HTTP server
# PORT=3000
