{
  "name": "@AWEtoAgent/a2a",
  "version": "0.2.0",
  "description": "Agent-to-Agent (A2A) protocol support for Lucid agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/awe-x402/AWEtoAgent-Kit",
    "directory": "packages/a2a"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@AWEtoAgent/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@AWEtoAgent/hono": "workspace:*",
    "@AWEtoAgent/core": "workspace:*",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
